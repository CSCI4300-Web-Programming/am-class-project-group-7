ng.character"},{value:"WORD",label:"motion.preset_flyout.text_stagger.grouping.word"},{value:"LINE",label:"motion.preset_flyout.text_stagger.grouping.line"},{value:"PARAGRAPH",label:"motion.preset_flyout.text_stagger.grouping.paragraph"}]}},{name:"elementTransformOriginX",type:h5.J0O.NUMBER,label:"motion.preset_flyout.text_stagger.transform_origin_offset",defaultNumber:50,inputConfig:{min:0,max:100,unit:"%",icon:"x"}},{name:"elementTransformOriginY",type:h5.J0O.NUMBER,label:"motion.preset_flyout.text_stagger.transform_origin_offset",defaultNumber:50,inputConfig:{min:0,max:100,unit:"%",icon:"y"}},{name:"delay",type:h5.J0O.NUMBER,label:"motion.preset_flyout.delay",defaultNumber:0,inputConfig:{unit:"s",icon:"delay"},numberResolvedAsTiming:!0},{name:"duration",type:h5.J0O.NUMBER,label:"motion.preset_flyout.duration",defaultNumber:.5,inputConfig:{min:.01,unit:"s",icon:"time"},numberResolvedAsTiming:!0},{name:"easing",type:h5.J0O.EASING,label:"motion.preset_flyout.easing",defaultEasing:{easingType:h5.mgy.OUT_CUBIC}},{name:"positionEnabled",type:h5.J0O.BOOL,label:"motion.preset_name.position",defaultBool:!0},{name:"positionVisible",type:h5.J0O.BOOL,label:"motion.preset_name.position",defaultBool:!0},...I6.filter(e=>"direction"===e.name||"distance"===e.name).map(e=>"direction"===e.name?{...e,defaultText:"top"}:{...e,defaultNumber:40}),{name:"rotationEnabled",type:h5.J0O.BOOL,label:"motion.preset_name.rotation",defaultBool:!1},{name:"rotationVisible",type:h5.J0O.BOOL,label:"motion.preset_name.rotation",defaultBool:!0},...wr(I7,new Set(["direction","amount"]),{direction:"rotationDirection",amount:"rotationAmount"}),{name:"scaleEnabled",type:h5.J0O.BOOL,label:"motion.preset_name.scale",defaultBool:!1},{name:"scaleVisible",type:h5.J0O.BOOL,label:"motion.preset_name.scale",defaultBool:!0},{name:"scaleAmount",type:h5.J0O.NUMBER,label:"motion.preset_flyout.amount",defaultNumber:120,inputConfig:{min:0,unit:"%"}},{name:"opacityEnabled",type:h5.J0O.BOOL,label:"motion.preset_name.opacity",defaultBool:!1},{name:"opacityVisible",type:h5.J0O.BOOL,label:"motion.preset_name.opacity",defaultBool:!0},...wr(I2,new Set(["amount"]),{amount:"opacityAmount"}),{name:"blurEnabled",type:h5.J0O.BOOL,label:"motion.preset_name.blur",defaultBool:!1},{name:"blurVisible",type:h5.J0O.BOOL,label:"motion.preset_name.blur",defaultBool:!0},{name:"blurAmount",type:h5.J0O.NUMBER,label:"motion.preset_flyout.amount",defaultNumber:20,inputConfig:{min:0,unit:"px",icon:"layer_blur"}}],wo={[h5.Ewp.FADE_DEPRECATED]:{name:"Fade",description:'Animates the opacity of an element to fade it in or out. Use this preset for entrance or exit animations, revealing content, or smooth visibility transitions.\n\nProperties:\n- timing: Select "Fade In" to animate from transparent to opaque, or "Fade Out" to animate from opaque to transparent.\n- duration: The length of the animation in seconds.\n- easing: The easing curve that controls the acceleration of the fade.',propDefs:IZ,manifest:{icon:"Fade",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:[],disallowedNodeFields:[]}},[h5.Ewp.MOVE_DEPRECATED]:{name:"Move",description:'Translates an element along the X and Y axes to slide it in or out of position. Use this preset for slide-in or slide-out transitions, off-screen entrances, or directional movement effects.\n\nProperties:\n- timing: Select "Move In" to slide from the offset position to the original position, or "Move Out" to slide from the original position to the offset.\n- moveX: The horizontal translation offset in pixels.\n- moveY: The vertical translation offset in pixels.\n- duration: The length of the animation in seconds.\n- fade: Enable to simultaneously fade the element\'s opacity during the move.\n- easing: The easing curve that controls the acceleration of the movement.',propDefs:IQ,manifest:{icon:"Move",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:[],disallowedNodeFields:[]}},[h5.Ewp.ROTATE_DEPRECATED]:{name:"Rotate",description:'Rotates an element by a specified angle to spin it in or out. Use this preset for spinning entrance or exit effects, turning animations, or attention-grabbing rotations.\n\nProperties:\n- timing: Select "Rotate In" to rotate from the specified angle back to the original orientation, or "Rotate Out" to rotate from the original orientation to the specified angle.\n- rotation: The rotation amount in degrees.\n- duration: The length of the animation in seconds.\n- fade: Enable to simultaneously fade the element\'s opacity during the rotation.\n- easing: The easing curve that controls the acceleration of the rotation.',propDefs:I8,manifest:{icon:"Rotate",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:[],disallowedNodeFields:[]}},[h5.Ewp.SCALE]:{name:"motion.preset_name.scale",description:'Animates a node by scaling it along the width and/or height axis. Use this preset for scale-in / scale-out reveal effects, or pick the Custom type for explicit start / end percentages on either axis.\n\nProperties:\n- type: "Scale in" animates amount \u2192 100%; "Scale out" animates 100% \u2192 amount; "Custom" lets you specify explicit start / end percentages per axis.\n- axis: For type=custom, picks which axis (W, H, or both combined) is animated. Ignored when type=scaleIn/scaleOut (both axes animate together).\n- amount: For type=scaleIn/scaleOut, the scale magnitude in percent (e.g. 120%).\n- {w,h}{Start,End}* / *WithDivider / *WithoutDivider: For type=custom, the explicit start / end percentages per axis. Single-axis groups each axis as Start+End; WH-combined groups both Starts together and both Ends together, using the alternate divider variants. Only the set visible in the current layout is editable.\n- delay / duration / easing: Shared timing.',propDefs:we,manifest:{icon:"Scale",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:[],disallowedNodeFields:[]}},[h5.Ewp.RESIZE_DEPRECATED]:{name:"Resize",description:"Changes the width and/or height of an element by a pixel offset over time. Use this preset for expanding panels, progress bar animations, or dynamic layout transitions.\n\nProperties:\n- widthChange: The amount to change the element's width in pixels (0 for no width change).\n- heightChange: The amount to change the element's height in pixels (0 for no height change).\n- duration: The length of the animation in seconds.\n- easing: The easing curve that controls the acceleration of the resize.",propDefs:I9,manifest:{icon:"Resize",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:[],disallowedNodeFields:[]}},[h5.Ewp.NEW]:{name:"motion.preset_name.new",description:"A minimal starter preset that fades an element in from transparent to opaque. Use this as a starting point for building custom animation presets \u2014 edit the generated code to add your own keyframe tracks and logic.\n\nProperties:\n- duration: The length of the animation in seconds.\n- easing: The easing curve that controls the acceleration of the animation.",propDefs:I1,manifest:{icon:"Default",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:[],disallowedNodeFields:[]}},[h5.Ewp.TEXT_DATA]:{name:"motion.preset_name.text",description:'Animates the text content of an element by keyframing textData with string values. Use this preset for typewriter effects that reveal text by character, word, or line.\n\nProperties:\n- revealBy: Select "Character", "Word", or "Line" to control how much text appears at each keyframe.\n- duration: The length of the animation in seconds.',propDefs:wn,manifest:{icon:"Text",applicableNodeTypes:["TEXT"],disallowedNodeTypes:[],requiredNodeFields:[],disallowedNodeFields:[]}},[h5.Ewp.PATH_DRAW_DEPRECATED]:{name:"Path Draw",description:'Animates the path trim of a stroke to draw it in or erase it over time. Use this preset for line drawing effects, signature animations, or progressive reveal of vector paths.\n\nProperties:\n- duration: The length of the animation in seconds.\n- direction: Select "Forward" to draw from the start of the path to the end, or "Reverse" to draw from the end of the path to the start.',propDefs:I3,manifest:{icon:"PathDraw",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:["strokes"],disallowedNodeFields:[]}},[h5.Ewp.PATH_TRAVEL_DEPRECATED]:{name:"Path Travel",description:'Animates a segment of a stroke that travels along the entire path. Use this preset for moving highlight effects or traveling dash animations on vector paths.\n\nProperties:\n- segmentLength: The length of the traveling segment as a percentage of the total path.\n- loops: The number of times the segment travels along the path.\n- loopMode: Select "Circle Back" to wrap continuously around the path, or "Retrace Path" to bounce forward then backward each loop.\n- direction: Select "Forward" to travel from the start to the end of the path, or "Reverse" to travel from the end to the start.\n- duration: The length of the animation in seconds.',propDefs:I5,manifest:{icon:"PathTravel",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:["strokes"],disallowedNodeFields:[]}},[h5.Ewp.OPACITY]:{name:"motion.preset_name.opacity",description:'Animates the opacity of an element. Use this preset for entrance / exit animations or emphasis effects.\n\nProperties:\n- type: "Fade In" animates 0\u21921, "Fade Out" animates 1\u21920, "Custom" lets you specify start and end opacity via Start Frame / End Frame.\n- startFrame / endFrame: Start and end opacity as percentages (only used when type is "Custom").\n- delay: How long to wait before the animation starts, in seconds.\n- duration: The length of the animation, in seconds.\n- easing: The easing curve that controls the acceleration of the animation.',propDefs:I2,manifest:{icon:"Opacity",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:[],disallowedNodeFields:[]}},[h5.Ewp.CORNER_RADIUS]:{name:"motion.preset_name.corner_radius",description:'Animates the corner radius of a node, either uniformly or per-corner. Use this preset for "round in / round out" reveal effects, or pick the Custom type for explicit start / end radius values per corner.\n\nProperties:\n- type: "Round in" animates 0 \u2192 amount; "Round out" animates amount \u2192 0; "Custom" lets each corner specify explicit start / end values.\n- corner: "All" drives the shared `cornerRadius` field; the four specific corner values drive only that corner. Toggling between "All" and a specific corner relies on the C++ preset bind path to flip `rectangleCornerRadiiIndependent` (see `_bindKeyframeExpressionToParameterField`).\n- amount: For type=roundIn/roundOut, the target radius in px.\n- *StartFrame / *EndFrame: For type=custom, the per-corner start/end radii. Only the pair matching the current `corner` selection is animated.\n- delay / duration / easing: Shared timing for the animation.',propDefs:I0,manifest:{icon:"CornerRadius",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:[],disallowedNodeFields:[]}},[h5.Ewp.ROTATION]:{name:"motion.preset_name.rotation",description:'Animates the rotation of a node about its center. Use this preset for spin-in / spin-out reveal effects, or pick the Custom type for explicit start / end angles.\n\nProperties:\n- type: "Rotate in" animates signed amount \u2192 0; "Rotate out" animates 0 \u2192 signed amount; "Custom" lets you specify explicit start / end angles in degrees. The signed amount is derived from Direction (see below).\n- direction: "Clockwise" or "Counter-clockwise". Underlying `rotate` is in radians and uses screen Y-down coordinates. For "Rotate in", Clockwise yields a negative angle and Counter-clockwise yields a positive angle. For "Rotate out", Clockwise yields a positive angle and Counter-clockwise yields a negative angle \u2014 matching the visible spin labels in both types.\n- amount: For type=rotateIn/rotateOut, the rotation magnitude in degrees.\n- start / end: For type=custom, the explicit start / end angles in degrees.\n- delay / duration / easing: Shared timing for the animation.',propDefs:I7,manifest:{icon:"Rotation",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:[],disallowedNodeFields:[]}},[h5.Ewp.PATH]:{name:"motion.preset_name.path",description:'Animates the trim of a vector path. Replaces and subsumes Path Draw and Path Travel under a single preset; pick a `type` to drive the behaviour.\n\nProperties:\n- type: "Draw" reveals the path from start to end; "Erase" hides it; "Travel" runs a short segment along the path; "Custom" exposes raw `pathTrimStart` / `pathTrimEnd` control via the `axis` prop.\n- direction: "Forward" or "Reverse"; reverses the animation direction.\n- segment: For type=travel, length of the moving segment as a percentage of the path.\n- axis: For type=custom, picks which trim field(s) to animate. "Path trim start" and "Path trim end" each drive one field. "Combined" drives both with shared timing but distinct initial values (`pathStartStartFrame`, `pathEndStartWithDivider`).\n- pathStart{StartFrame,EndFrame} / pathEnd{StartFrame,EndFrame}: For type=custom, the per-trim frame values. The bespoke component shows only the subset relevant to the current axis selection.\n- delay / duration / easing: Shared timing for every type (Draw / Erase / Travel and Custom).',propDefs:I4,manifest:{icon:"Path",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:["strokes"],disallowedNodeFields:[]}},[h5.Ewp.POSITION]:{name:"motion.preset_name.position",description:'Animates a node along the X and/or Y axes. Use this preset for slide-in / slide-out entrances and exits, or fully custom translate animations.\n\nProperties:\n- type: "Slide In" animates from an offset back to the resting position, "Slide Out" animates from the resting position to an offset, "Custom" lets you specify Start / End values explicitly.\n- direction: For Slide In / Slide Out, the side the element slides from / to (only used when type is "Slide In" or "Slide Out").\n- distance: Slide distance in pixels (only used when type is "Slide In" or "Slide Out").\n- axis: For Custom, which axes to animate \u2014 "X" / "Y" animate one axis only, "XY" animates both (each axis keeps its own start/end and they share the timing).\n- startX / endX: X-axis start and end translation in pixels (used when type is "Custom" and axis is "X" or "XY").\n- startY / endY: Y-axis start and end translation in pixels (used when type is "Custom" and axis is "Y" or "XY").\n- delay: How long to wait before the animation starts, in seconds.\n- duration: The length of a single playthrough, in seconds.\n- easing: The easing curve that controls the acceleration of the animation.',propDefs:I6,manifest:{icon:"Position",applicableNodeTypes:[],disallowedNodeTypes:[],requiredNodeFields:[],disallowedNodeFields:[]}},[h5.Ewp.SIZE]:{name:"motion.preset_name.size",description:'Animates a node\u2019s width and/or height. Use this preset for resize-in / resize-out entrances and exits, or fully custom resize animations.\n\nProperties:\n- type: "Resize In" starts at the resting size and shrinks by `amount`, "Resize Out" starts shrunk by `amount` and grows back to the resting size, "Custom" lets you specify Start / End values explicitly.\n- amount: How many pixels to shrink the width AND height by (only used when type is "Resize In" or "Resize Out").\n- axis: For Custom, which axes to animate \u2014 "X" / "Y" animate one axis only, "Both" animates both (each axis keeps its own start/end and they share the timing).\n- startWidth / endWidth: Width start and end offset in pixels relative to the resting size (used when type is "Custom" and axis is "X" or "Both").\n- startHeight / endHeight: Height start and end offset in pixels relative to the resting size (used when type is "Custom" and axis is "Y" or "Both").\n- delay: How long to wait before the animation starts, in seconds.\n- duration: The length of a single playthrough, in seconds.\n- easing: The easing curve that controls the acceleration 